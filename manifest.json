{
  "manifest_version": 3,
  "name": "多系统智能填表助手",
  "version": "1.0.0",
  "description": "右侧边栏智能识别表单、Excel 批量自动录入提交与失败导出",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "src/index.html"
  },
  "action": {
    "default_title": "点击打开智能填表助手侧边栏"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "host_permissions": [
    "file:///*"
  ],  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ]
}
